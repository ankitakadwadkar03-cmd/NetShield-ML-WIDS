+  font-weight: 600;
+  padding: 4px 10px;
+  border-radius: 4px;
+  cursor: pointer;
+  transition: all 0.15s ease;
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.drawer-json-copy-btn:hover,
+.drawer-json-toggle-btn:hover {
+  background: rgba(56, 189, 248, 0.18);
+  border-color: #38bdf8;
+  color: #ffffff;
+}
+
+.drawer-json-copy-btn.copy-error {
+  background: rgba(239, 68, 68, 0.15);
+  border-color: #ef4444;
+  color: #f87171;
+}
+
+.scan-button.button-error {
+  background: rgba(239, 68, 68, 0.2);
+  border-color: #ef4444;
+  color: #f87171;
+}
+
+.drawer-json-toggle-btn {
+  background: rgba(20, 184, 166, 0.1);
+  border-color: rgba(20, 184, 166, 0.3);
+  color: #14b8a6;
+}
+
+.drawer-json-toggle-btn:hover {
+  background: rgba(20, 184, 166, 0.22);
+  border-color: #14b8a6;
+  color: #ffffff;
+}
+
+.drawer-json-collapsed-box {
+  background: #080d1a;
+  border: 1px dashed rgba(56, 189, 248, 0.25);
+  border-radius: 6px;
+  padding: 14px 16px;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 12px;
+  cursor: pointer;
+  transition: all 0.15s ease;
+}
+
+.drawer-json-collapsed-box:hover {
+  background: rgba(15, 23, 42, 0.85);
+  border-color: #38bdf8;
+}
+
+.drawer-json-collapsed-text {
+  font-size: 0.76rem;
+  color: #94a3b8;
+  font-family: monospace;
+}
+
+.drawer-json-collapsed-link {
+  font-size: 0.74rem;
+  font-weight: 600;
+  color: #14b8a6;
+  white-space: nowrap;
+}
+
+.drawer-json-collapsed-box:hover .drawer-json-collapsed-link {
+  text-decoration: underline;
+  color: #38bdf8;
+}
+
+.drawer-json-viewer {
+  background: #080d1a;
+  border: 1px solid rgba(56, 189, 248, 0.2);
+  border-radius: 6px;
+  padding: 12px;
+  max-height: 260px;
+  overflow: auto;
+  font-family: monospace;
+  font-size: 0.75rem;
+  line-height: 1.4;
+  color: #38bdf8;
+  margin: 0;
+}
+
+.incident-drawer-footer {
+  padding: 14px 22px;
+  border-top: 1px solid rgba(56, 189, 248, 0.2);
+  background: #0b1120;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 10px;
+}
+
+@media (max-width: 768px) {
+  .incident-drawer {
+    max-width: 100%;
+  }
+}

