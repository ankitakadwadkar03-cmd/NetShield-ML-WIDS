+
+/* =========================================================================
+   Incident Drawer & Forensics Overlay
+   ========================================================================= */
+.incident-drawer-backdrop {
+  position: fixed;
+  inset: 0;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  width: 100vw;
+  height: 100vh;
+  background: rgba(8, 13, 26, 0.75);
+  backdrop-filter: blur(5px);
+  z-index: 2000;
+  display: flex;
+  justify-content: flex-end;
+}
+
+.incident-drawer {
+  width: 100%;
+  max-width: 500px;
+  height: 100%;
+  background: #0f172a;
+  border-left: 1px solid rgba(56, 189, 248, 0.2);
+  box-shadow: -8px 0 24px rgba(0, 0, 0, 0.6);
+  display: flex;
+  flex-direction: column;
+  animation: slideDrawer 0.2s cubic-bezier(0.16, 1, 0.3, 1);
+  overflow-y: auto;
+  color: #f1f5f9;
+}
+
+@keyframes slideDrawer {
+  from {
+    transform: translateX(100%);
+  }
+  to {
+    transform: translateX(0);
+  }
+}
+
+.incident-drawer-header {
+  padding: 18px 22px;
+  border-bottom: 1px solid rgba(56, 189, 248, 0.2);
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  background: #0b1120;
+}
+
+.drawer-title-group h3 {
+  margin: 4px 0 0;
+  font-size: 1.15rem;
+  color: #f8fafc;
+}
+
+.drawer-pill {
+  font-size: 0.68rem;
+  font-weight: 700;
+  letter-spacing: 0.06em;
+  padding: 2px 7px;
+  border-radius: 4px;
+  background: rgba(20, 184, 166, 0.15);
+  color: #14b8a6;
+  border: 1px solid rgba(20, 184, 166, 0.3);
+  display: inline-block;
+}
+
+.modal-close-button {
+  background: transparent;
+  border: none;
+  color: #94a3b8;
+  font-size: 1.5rem;
+  cursor: pointer;
+  line-height: 1;
+}
+
+.modal-close-button:hover {
+  color: #f8fafc;
+}
+
+.incident-drawer-body {
+  padding: 20px 22px;
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  flex: 1;
+}
+
+.drawer-verdict-card {
+  background: #0b1120;
+  border: 1px solid rgba(56, 189, 248, 0.2);
+  border-radius: 8px;
+  padding: 14px 16px;
+}
+
+.drawer-verdict-header {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  align-items: center;
+  margin-bottom: 12px;
+}
+
+.badge-lg {
+  font-size: 0.85rem;
+  padding: 4px 10px;
